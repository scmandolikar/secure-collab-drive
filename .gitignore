# Python Virtual Environment
# This folder contains all your installed libraries and is machine-specific
venv/
*.venv

# Python cache files
# These are generated by Python as it runs
__pycache__/
*.pyc
*.pyo

# Application Data
# This is your database file. It's generated by app.py
project.db
*.sqlite
*.sqlite3

# This folder contains all user-uploaded encrypted files
uploads/

# IDE & OS specific files
# VS Code settings
.vscode/
# macOS junk file
.DS_Store
# Windows thumbnail cache
Thumbs.db